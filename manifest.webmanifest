{
  "name": "Kcal & Protein Tracker",
  "short_name": "Kcal",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#12181b",
  "theme_color": "#12181b",
  "lang": "de",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Bin wach",
      "short_name": "Bin wach",
      "description": "Essens-Erinnerungen an deine Aufstehzeit anpassen",
      "url": "./?wach=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
